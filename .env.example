# Copy this file to .env and fill in your Xero app's credentials.
#
# Create an app at https://developer.xero.com/app/manage
#   - App type:      "Web app"
#   - Redirect URI:  http://localhost:5173/callback   (must match XERO_REDIRECT_URI below)
#   - Grab the Client ID, then "Generate a secret" and grab that too — Xero won't
#     treat the app as enabled without a secret, and `npm run auth` then fails with
#     "unauthorized_client: Unknown client or client not enabled". It's shown once.
#   - Scopes need no setup: `npm run auth` works out which ones your app has and
#     warns about anything it therefore can't archive.

# Required
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# Must exactly match a redirect URI registered on your Xero app.
XERO_REDIRECT_URI=http://localhost:5173/callback

# Where the rotating refresh token is stored (default: .tokens.json). Only needed if
# you use more than one Xero app: a refresh token is bound to the app that issued it,
# so give each app its own file and its own .env, then run e.g.
#   node --env-file=.env.app2 node_modules/.bin/tsx src/cli.ts archive
XERO_TOKENS_FILE=

# Pin the requested OAuth scopes (space- or comma-separated). Leave blank to let
# `npm run auth` request the full read-only set and drop whatever your app isn't
# assigned. Setting this uses your list verbatim and skips that negotiation.
XERO_SCOPES=

# Port the local callback server listens on during `npm run auth`.
# Must match the port in XERO_REDIRECT_URI.
AUTH_CALLBACK_PORT=5173

# --- Optional tuning ---------------------------------------------------------

# Pull the per-document audit trail (History & Notes) DURING the main archive.
# Off by default because it costs one extra API call PER document. Recommended
# workflow instead: archive first, then run the dedicated, resumable backfill:
#   npm run archive  →  npm run history  →  npm run site
# Set this to true only if you want history captured inline on every archive run.
INCLUDE_HISTORY=false

# Pull period financial statements (P&L, Balance Sheet, Trial Balance).
INCLUDE_REPORTS=true

# Report snapshot granularity: "year" or "month".
REPORT_PERIOD=year

# Earliest year to snapshot reports from. Defaults to the org's financial year
# start discovered from the API if left blank.
REPORT_FROM_YEAR=

# Stop the run this many API calls before the daily limit, to leave headroom.
DAILY_LIMIT_BUFFER=50
